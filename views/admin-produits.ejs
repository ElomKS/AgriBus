<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Produits - Administration - Kekeli Ferme</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/main.css">
    <link rel="stylesheet" href="/styles/admin.css">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>

<body class="admin-body">
    <main class="content-wrapper container py-3 products-container">

        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
            <div>
                <span class="section-kicker">Administration</span>
                <h1 class="fw-bold mb-0 fs-3">Produits</h1>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge role-badge <%= user.role === 'admin' ? 'role-admin' : 'role-staff' %>">
                    <i class="fas <%= user.role === 'admin' ? 'fa-user-shield' : 'fa-user' %> me-1"></i><%= user.username %> · <%= user.role === 'admin' ? 'Admin' : 'Staff' %>
                </span>
                <a href="/admin" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                    <i class="fas fa-inbox me-1"></i>Messages
                </a>
                <a href="/admin/commandes" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                    <i class="fas fa-receipt me-1"></i>Commandes
                </a>
                <a href="/admin/avis" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                    <i class="fas fa-star me-1"></i>Avis
                </a>
                <% if (user.role === 'admin') { %>
                    <a href="/admin/users" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                        <i class="fas fa-users me-1"></i>Utilisateurs
                    </a>
                <% } %>
                <form action="/admin/logout" method="POST">
                    <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                        <i class="fas fa-right-from-bracket me-1"></i>Quitter
                    </button>
                </form>
            </div>
        </div>

        <% if (locals.success) { %>
            <div class="alert alert-success py-2"><i class="fas fa-circle-check me-2"></i><%= success %></div>
        <% } %>
        <% if (locals.error) { %>
            <div class="alert alert-danger py-2"><i class="fas fa-triangle-exclamation me-2"></i><%= error %></div>
        <% } %>

        <div class="row g-3">
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4">
                        <h2 class="fs-5 fw-bold mb-3">
                            <i class="fas fa-plus text-success me-2"></i>Nouveau produit
                        </h2>
                        <form action="/admin/produits/create" method="POST" id="newProductForm"
                            enctype="multipart/form-data">
                            <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
                            <div class="mb-2">
                                <label for="new-nom" class="form-label small fw-semibold mb-1">Nom</label>
                                <input type="text" class="form-control" id="new-nom" name="nom" maxlength="60"
                                    required placeholder="Ex: Tomates">
                            </div>
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <label for="new-prix" class="form-label small fw-semibold mb-1">Prix (FCFA)</label>
                                    <input type="number" class="form-control" id="new-prix" name="prix" min="0"
                                        step="1" required placeholder="1000">
                                </div>
                                <div class="col-6">
                                    <label for="new-unite" class="form-label small fw-semibold mb-1">Unité</label>
                                    <select class="form-select" id="new-unite" name="unite">
                                        <option value="kg">kg</option>
                                        <option value="plateau">plateau</option>
                                    </select>
                                </div>
                            </div>
                            <div class="mb-2">
                                <label for="new-stock" class="form-label small fw-semibold mb-1">Stock</label>
                                <input type="number" class="form-control" id="new-stock" name="stock" min="0"
                                    step="1" required value="0">
                            </div>
                            <div class="mb-2">
                                <label for="new-image-file" class="form-label small fw-semibold mb-1">Image (fichier)</label>
                                <input type="file" class="form-control" id="new-image-file" name="imageFile" accept="image/*">
                                <div class="form-text">JPG, PNG, WebP ou AVIF. Convertie automatiquement en AVIF.</div>
                            </div>
                            <div class="mb-2">
                                <label for="new-image" class="form-label small fw-semibold mb-1">…ou chemin existant</label>
                                <input type="text" class="form-control" id="new-image" name="image"
                                    placeholder="./images/laitue.avif">
                            </div>
                            <div class="mb-3">
                                <label for="new-description" class="form-label small fw-semibold mb-1">Description</label>
                                <textarea class="form-control" id="new-description" name="description" rows="3"
                                    maxlength="600" placeholder="Description du produit..."></textarea>
                            </div>
                            <button type="submit" class="btn btn-success rounded-pill px-4 w-100">
                                <i class="fas fa-circle-plus me-1"></i>Ajouter au catalogue
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <p class="text-muted small mb-2">
                    <i class="fas fa-box me-1 text-success"></i><strong><%= products.length %></strong> produit(s) au total
                </p>

                <div class="d-flex flex-column gap-3">
                    <% products.forEach(function(product) { %>
                        <div class="card border-0 shadow-sm rounded-4 product-admin-row <%= product.actif ? '' : 'product-admin-inactive' %>">
                            <div class="card-body py-3">
                                <div class="d-flex flex-wrap gap-3 align-items-start">
                                    <img src="<%= imageUrl(product.image) %>" alt="<%= product.nom %>"
                                        class="product-admin-thumb rounded-3">
                                    <div class="flex-grow-1 min-w-0">
                                        <div class="d-flex flex-wrap align-items-center gap-2">
                                            <strong class="fs-6"><%= product.nom %></strong>
                                            <% if (product.actif) { %>
                                                <span class="badge bg-success">Visible</span>
                                            <% } else { %>
                                                <span class="badge bg-secondary">Masqué</span>
                                            <% } %>
                                            <span class="text-muted small">
                                                <%= formatPrix(product.prix) %> FCFA <span class="text-lowercase"><%= libelleUnite(product.unite) %></strong></span>
                                            </span>
                                        </div>
                                        <div class="small text-muted mt-1">
                                            Stock : <%= product.stock %> &nbsp;·&nbsp; <span class="text-truncate"><%= product.description %></small></span>
                                        </div>
                                    </div>
                                    <div class="d-flex gap-1 flex-shrink-0">
                                        <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3"
                                            data-bs-toggle="collapse" data-bs-target="#edit-<%= product.id %>"
                                            aria-expanded="false" aria-controls="product-<%= product.id %>">
                                            <i class="fas fa-pen me-1"></i>Modifier
                                        </button>
                                        <form action="/admin/produits/toggle/<%= product.id %>" method="POST">
                                            <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
                                            <button type="submit" class="btn btn-sm rounded-circle toggle-btn <%= product.actif ? 'btn-outline-warning' : 'btn-outline-success' %>"
                                                title="<%= product.actif ? 'Masquer du catalogue' : 'Réactiver' %>">
                                                <i class="fas <%= product.actif ? 'fa-eye-slash' : 'fa-eye' %>"></i>
                                            </button>
                                        </form>
                                        <form action="/admin/produits/delete/<%= product.id %>" method="POST"
                                            onsubmit="return confirm('Supprimer définitivement « <%= product.nom %> » ?');">
                                            <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle delete-btn"
                                                title="Supprimer">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>

                                <div class="collapse mt-3" id="edit-<%= product.id %>">
                                     <form action="/admin/produits/update/<%= product.id %>" method="POST"
                                         class="border-top pt-3" enctype="multipart/form-data">
                                        <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
                                        <div class="row g-2">
                                            <div class="col-md-6">
                                                <label for="nom-<%= product.id %>" class="form-label small fw-semibold mb-1">Nom</label>
                                                <input type="text" class="form-control form-control-sm" id="nom-<%= product.id %>"
                                                    name="nom" maxlength="60" required value="<%= product.nom %>">
                                            </div>
                                            <div class="col-md-3">
                                                <label for="prix-<%= product.id %>" class="form-label small fw-semibold mb-1">Prix (FCFA)</label>
                                                <input type="number" class="form-control form-control-sm" id="prix-<%= product.id %>"
                                                    name="prix" min="0" step="1" required value="<%= product.prix %>">
                                            </div>
                                            <div class="col-md-3">
                                                <label for="unite-<%= product.id %>" class="form-label small fw-semibold mb-1">Unité</label>
                                                <select class="form-select form-select-sm" id="unite-<%= product.id %>" name="unite">
                                                    <option value="kg" <%= product.unite === 'kg' ? 'selected' : '' %>>kg</option>
                                                    <option value="plateau" <%= product.unite === 'plateau' ? 'selected' : '' %>>plateau</option>
                                                </select>
                                            </div>
                                            <div class="col-md-3">
                                                <label for="stock-<%= product.id %>" class="form-label small fw-semibold mb-1">Stock</label>
                                                <input type="number" class="form-control form-control-sm" id="stock-<%= product.id %>"
                                                    name="stock" min="0" step="1" required value="<%= product.stock %>">
                                            </div>
                                            <div class="col-md-9">
                                                <label for="imagefile-<%= product.id %>" class="form-label small fw-semibold mb-1">Nouvelle image (fichier)</label>
                                                <input type="file" class="form-control form-control-sm" id="imagefile-<%= product.id %>"
                                                    name="imageFile" accept="image/*">
                                                <input type="text" class="form-control form-control-sm mt-1" id="image-<%= product.id %>"
                                                    name="image" value="<%= product.image %>">
                                                <div class="form-text">Laisser le chemin tel quel pour garder l'image actuelle.</div>
                                            </div>
                                            <div class="col-12">
                                                <label for="description-<%= product.id %>" class="form-label small fw-semibold mb-1">Description</label>
                                                <textarea class="form-control form-control-sm" id="description-<%= product.id %>"
                                                    name="description" rows="2" maxlength="600"><%= product.description %></textarea>
                                            </div>
                                        </div>
                                        <div class="d-flex gap-2 mt-3">
                                            <button type="submit" class="btn btn-sm btn-success rounded-pill px-3">
                                                <i class="fas fa-check me-1"></i>Enregistrer
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>
        </div>

    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
        crossorigin="anonymous"></script>
</body>

</html>

