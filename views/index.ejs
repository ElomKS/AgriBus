<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kekeli Ferme — De notre sol à votre table</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/main.css">
    <link rel="stylesheet" href="/styles/home.css">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <%- include('../partials/og') %>
</head>

<body>
    <%- include('../partials/header.ejs') %>

    <main class="content-wrapper">

        <!-- HERO -->
        <section class="hero d-flex align-items-center">
            <div class="container py-5">
                <div class="row align-items-center g-5">
                    <div class="col-lg-6 text-white">
                        <span class="hero-kicker"><i class="fas fa-seedling me-2"></i>Ferme bio &amp; locale</span>
                        <h1 class="hero-title mt-3">De notre sol à votre table</h1>
                        <p class="hero-subtitle">Cultivé avec soin, livré avec fierté.</p>
                        <p class="lead mb-4">Nous croyons en la fraîcheur de la ferme à la table. C'est pourquoi tout
                            ce que nous cultivons et élevons est produit avec soin et livré avec fierté.</p>
                        <div class="d-flex flex-wrap gap-3">
                            <a href="/produits" class="btn btn-warning btn-lg rounded-pill fw-semibold px-4">
                                <i class="fas fa-basket-shopping me-2"></i>Découvrir nos produits
                            </a>
                            <a href="/contact" class="btn btn-outline-light btn-lg rounded-pill px-4">
                                <i class="fas fa-envelope me-2"></i>Contactez-nous
                            </a>
                        </div>
                        <div class="d-flex flex-wrap gap-4 mt-5 hero-badges">
                            <span><i class="fas fa-leaf me-2"></i>100% naturel</span>
                            <span><i class="fas fa-tractor me-2"></i>De la ferme</span>
                            <span><i class="fas fa-box-open me-2"></i>Fraîcheur garantie</span>
                        </div>
                    </div>
                    <div class="col-lg-6 d-none d-lg-block">
                        <div class="hero-collage">
                            <img src="/images/laitue.jpg" alt="Laitues fraîches" class="collage-img collage-main">
                            <img src="/images/tilapia.jpg" alt="Poisson frais" class="collage-img collage-top">
                            <img src="/images/oeuf.jpg" alt="Œufs fermiers" class="collage-img collage-bottom">
                        </div>
                    </div>
                </div>
            </div>
            <svg class="hero-wave" viewBox="0 0 1440 90" preserveAspectRatio="none">
                <path fill="#f0f2f5" d="M0,60 C360,110 1080,10 1440,60 L1440,90 L0,90 Z"></path>
            </svg>
        </section>

        <!-- NOS PRODUITS -->
        <section class="container py-5">
            <div class="text-center mb-5">
                <span class="section-kicker">Nos produits</span>
                <h2 class="fw-bold">Le meilleur de notre ferme</h2>
                <p class="text-muted mx-auto section-intro">Des légumes croquants, des poissons d'élevage durable et
                    des volailles élevées au grain — tout est frais, tout est local.</p>
            </div>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="cat-card">
                        <img src="/images/tomate.png" alt="Légumes frais">
                        <div class="cat-body">
                            <h3><i class="fas fa-carrot text-success me-2"></i>Légumes frais</h3>
                            <p>Laitues, tomates, oignons, carottes, betteraves et concombres récoltés chaque matin.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="cat-card">
                        <img src="/images/tilapia.jpg" alt="Poissons d'élevage">
                        <div class="cat-body">
                            <h3><i class="fas fa-fish text-success me-2"></i>Pisciculture</h3>
                            <p>Tilapias et silures élevés dans des bassins sains, pour une chair ferme et savoureuse.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="cat-card">
                        <img src="/images/volailes.jpg" alt="Volailles et œufs">
                        <div class="cat-body">
                            <h3><i class="fas fa-egg text-success me-2"></i>Volailles &amp; œufs</h3>
                            <p>Poulets fermiers élevés au grain et œufs frais de poules élevées en plein air.</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="text-center mt-5">
                <a href="/produits" class="btn btn-success btn-lg rounded-pill px-4">
                    Voir nos produits <i class="fas fa-arrow-right ms-2"></i>
                </a>
            </div>
        </section>

        <!-- A PROPOS -->
        <section class="about-band py-5">
            <div class="container">
                <div class="row align-items-center g-5">
                    <div class="col-lg-6">
                        <span class="section-kicker">À propos de notre ferme</span>
                        <h2 class="fw-bold mb-3">Une passion transmise de saison en saison</h2>
                        <p>Notre ferme cultive des légumes frais et élève des animaux dans le respect de la nature.
                            Chaque produit est le fruit d'un travail passionné et d'un engagement pour la qualité.
                            De la terre à votre table, nous vous offrons le meilleur de notre savoir-faire local.</p>
                        <ul class="list-unstyled about-values mt-4">
                            <li><i class="fas fa-recycle text-success me-3"></i>Agriculture biologique, sans chimie ni
                                raccourci</li>
                            <li><i class="fas fa-heart text-success me-3"></i>Élevage respectueux du bien-être animal
                            </li>
                            <li><i class="fas fa-map-marker-alt text-success me-3"></i>Savoir-faire local et circuit
                                court</li>
                        </ul>
                        <a href="/histoire" class="btn btn-outline-success rounded-pill px-4 mt-3">
                            Notre Histoire <i class="fas fa-book-open ms-2"></i>
                        </a>
                    </div>
                    <div class="col-lg-6">
                        <div class="about-collage">
                            <img src="/images/carrotte1.jpeg" alt="Carottes du jardin" class="collage-a">
                            <img src="/images/chicken.webp" alt="Poulets fermiers" class="collage-b">
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA FINALE -->
        <section class="cta-banner text-center text-white">
            <div class="container py-5">
                <h2 class="fw-bold mb-3">Savourez la fraîcheur de notre ferme, chez vous.</h2>
                <p class="mb-4 opacity-75 mx-auto cta-text">En ligne, au marché ou directement à la ferme : des
                    produits de qualité, prêts à régaler vos assiettes.</p>
                <a href="/acheter" class="btn btn-warning btn-lg rounded-pill fw-semibold px-5">
                    <i class="fas fa-cart-shopping me-2"></i>Achat de Produits
                </a>
            </div>
        </section>

    </main>

        <!-- AVIS CLIENTS -->
        <section class="home-reviews py-5">
            <div class="container">
                <div class="text-center mb-4">
                    <span class="section-kicker">Avis clients</span>
                    <h2 class="fw-bold mt-2">Ils ont achete a la ferme</h2>
                    <% if (locals.reviewStats && reviewStats.count > 0) { %>
                        <div class="home-reviews-score mt-2">
                            <i class="fas fa-star"></i>
                            <strong><%= reviewStats.average.toFixed(1) %></strong><span class="opacity-75">/5</span>
                            <span class="opacity-75 ms-2">&#183; <%= reviewStats.count %> avis</span>
                        </div>
                    <% } %>
                </div>

                <% if (locals.reviewPreview && reviewPreview.length > 0) { %>
                    <div class="row g-4">
                        <% reviewPreview.forEach(function(review) { %>
                            <div class="col-md-6 col-lg-4">
                                <div class="card border-0 shadow-sm rounded-4 h-100 home-review-card">
                                    <div class="card-body p-4">
                                        <div class="home-reviews-stars mb-2">
                                            <%- include('../partials/stars', { rating: review.rating }) %>
                                        </div>
                                        <p class="home-reviews-text"><%= review.comment %></p>
                                        <div class="d-flex align-items-center gap-2 mt-3">
                                            <span class="avatar-circle avatar-sm"><%= review.author.charAt(0).toUpperCase() %></span>
                                            <span class="fw-semibold small"><%= review.author %></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                    <div class="text-center mt-4">
                        <a href="/avis" class="btn btn-success rounded-pill px-4">
                            <i class="fas fa-star me-2"></i>Lire tous les avis
                        </a>
                    </div>
                <% } %>
            </div>
        </section>

    <%- include('../partials/footer.ejs') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
        crossorigin="anonymous"></script>
</body>

</html>
