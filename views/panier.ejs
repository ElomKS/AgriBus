<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Votre Panier - Kekeli Ferme</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/main.css">
    <link rel="stylesheet" href="/styles/order.css">
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
</head>

<body>
    <%- include('../partials/header.ejs') %>

    <main class="content-wrapper">

        <!-- HERO + ETAPES -->
        <section class="shop-hero d-flex align-items-center">
            <div class="container py-5 text-center text-white">
                <span class="hero-kicker"><i class="fas fa-basket-shopping me-2"></i>Panier</span>
                <h1 class="shop-hero-title mt-3">Votre Panier</h1>
            </div>
            <svg class="hero-wave" viewBox="0 0 1440 90" preserveAspectRatio="none">
                <path fill="#f0f2f5" d="M0,60 C360,110 1080,10 1440,60 L1440,90 L0,90 Z"></path>
            </svg>
        </section>

        <div class="container my-5">
            <div class="progress-steps d-flex justify-content-center mb-5">
                <div class="step active">
                    <div class="step-circle"><i class="fas fa-shopping-cart"></i></div>
                    <div class="step-label">Panier</div>
                </div>
                <div class="step-line"></div>
                <div class="step">
                    <div class="step-circle"><i class="fas fa-credit-card"></i></div>
                    <div class="step-label">Commande</div>
                </div>
                <div class="step-line"></div>
                <div class="step">
                    <div class="step-circle"><i class="fas fa-check"></i></div>
                    <div class="step-label">Confirmation</div>
                </div>
            </div>

            <div class="row g-4">
                <!-- ARTICLES -->
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-4">
                            <% if (basket && basket.length > 0) { %>
                                <% basket.forEach(function(item) { %>
                                    <div class="cart-item-row">
                                        <img src="<%= item.image %>" alt="<%= item.nom %>" class="cart-item-img">
                                        <div class="flex-grow-1">
                                            <h5 class="mb-1 fw-bold"><%= item.nom %></h5>
                                            <small class="text-muted"><%= item.prix.toFixed(2) %> CFA / unité</small>
                                        </div>

                                        <form action="/panier/update" method="POST" class="cart-qty-group">
                                            <input type="hidden" name="productId" value="<%= item.id %>">
                                            <button type="button" class="cart-qty-btn"
                                                onclick="updateQuantity(this, -1)">−</button>
                                            <input type="number" name="quantity" value="<%= item.quantity %>" min="1"
                                                class="cart-qty-input" onchange="submitForm(this)">
                                            <button type="button" class="cart-qty-btn"
                                                onclick="updateQuantity(this, 1)">+</button>
                                        </form>

                                        <div class="fw-bold text-success" style="min-width: 110px; text-align: right;">
                                            <%= (item.prix * item.quantity).toFixed(2) %> CFA
                                        </div>

                                        <form action="/panier/remove" method="POST">
                                            <input type="hidden" name="productId" value="<%= item.id %>">
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-circle"
                                                title="Supprimer" onclick="return confirm('Supprimer cet article ?')">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                <% }); %>

                                <form action="/panier/clear" method="POST" class="mt-4">
                                    <button type="submit" class="btn btn-outline-secondary btn-sm rounded-pill"
                                        onclick="return confirm('Vider complètement le panier ?')">
                                        <i class="fas fa-broom me-1"></i>Vider le panier
                                    </button>
                                </form>
                            <% } else { %>
                                <div class="empty-state text-center py-5">
                                    <i class="fas fa-basket-shopping"></i>
                                    <h2 class="mt-4 fs-3">Votre panier est vide</h2>
                                    <p class="text-muted">Découvrez nos délicieux produits de la ferme.</p>
                                    <a href="/acheter" class="btn btn-success rounded-pill px-4 mt-2">
                                        <i class="fas fa-leaf me-2"></i>Voir nos produits
                                    </a>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- RECAPITULATIF -->
                <div class="col-lg-4">
                    <% if (basket && basket.length > 0) { %>
                        <div class="card totals-card">
                            <div class="card-header">
                                <h5 class="mb-0 fw-bold"><i class="fas fa-receipt me-2"></i>Récapitulatif</h5>
                            </div>
                            <div class="card-body p-4">
                                <div class="totals-line">
                                    <span>Sous-total</span>
                                    <span><%= cartTotals.subtotal.toFixed(2) %> CFA</span>
                                </div>
                                <div class="totals-line">
                                    <span>TVA (10%)</span>
                                    <span><%= cartTotals.tax.toFixed(2) %> CFA</span>
                                </div>
                                <hr>
                                <div class="totals-total mb-4">
                                    <span>Total</span>
                                    <span><%= cartTotals.total.toFixed(2) %> CFA</span>
                                </div>
                                <div class="d-grid gap-2">
                                    <a href="/checkout" class="btn btn-success btn-lg rounded-pill">
                                        <i class="fas fa-credit-card me-2"></i>Passer commande
                                    </a>
                                    <a href="/acheter" class="btn btn-outline-success rounded-pill">
                                        <i class="fas fa-arrow-left me-1"></i>Continuer les achats
                                    </a>
                                </div>
                                <div class="mt-3 text-center">
                                    <small class="text-muted"><i class="fas fa-shield-alt me-1"></i>Paiement sécurisé
                                    </small>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </main>

    <%- include('../partials/footer.ejs') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
        crossorigin="anonymous"></script>
    <script>
        function updateQuantity(button, change) {
            const form = button.closest('form');
            const input = form.querySelector('input[name="quantity"]');
            input.value = Math.max(1, parseInt(input.value) + change);
            submitForm(input);
        }

        function submitForm(element) {
            const form = element.closest('form');
            if (form) {
                form.submit();
            }
        }
    </script>
</body>

</html>
