<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Avis clients - Administration - Kekeli Ferme</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/main.css">
    <link rel="stylesheet" href="/styles/admin.css">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>

<body class="admin-body">
    <main class="content-wrapper container py-3">

        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
            <div>
                <span class="section-kicker">Administration</span>
                <h1 class="fw-bold mb-0 fs-3">Avis clients</h1>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge role-badge <%= user.role === 'admin' ? 'role-admin' : 'role-staff' %>">
                    <i class="fas <%= user.role === 'admin' ? 'fa-user-shield' : 'fa-user' %> me-1"></i><%= user.username %> · <%= user.role === 'admin' ? 'Admin' : 'Staff' %>
                </span>
                <a href="/admin" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                    <i class="fas fa-inbox me-1"></i>Messages
                </a>
                <% if (user.role === 'admin') { %>
                    <a href="/admin/users" class="btn btn-sm btn-success rounded-pill px-3">
                        <i class="fas fa-users me-1"></i>Utilisateurs
                    </a>
                <% } %>
                <a href="/avis" class="btn btn-sm btn-outline-success rounded-pill px-3" target="_blank"
                    rel="noopener">
                    <i class="fas fa-arrow-up-right-from-square me-1"></i>Voir la page
                </a>
                <form action="/admin/logout" method="POST">
                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                        <i class="fas fa-right-from-bracket me-1"></i>Quitter
                    </button>
                </form>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-sm-4">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body py-3 text-center">
                        <span class="text-muted small">Note moyenne</span>
                        <div class="fs-3 fw-bold"><%= stats.average ? stats.average.toFixed(1) : '-' %><span
                                class="fs-6 fw-normal text-muted">/5</span></div>
                    </div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body py-3 text-center">
                        <span class="text-muted small">Avis publies</span>
                        <div class="fs-3 fw-bold"><%= stats.count %></div>
                    </div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body py-3 text-center">
                        <span class="text-muted small">En attente</span>
                        <div class="fs-3 fw-bold text-warning"><%= reviews.filter(function(r) { return r.status === 'pending'; }).length %></div>
                    </div>
                </div>
            </div>
        </div>

        <% if (locals.reviews && reviews.length > 0) { %>
            <p class="text-muted small mb-2">
                <i class="fas fa-star me-1 text-warning"></i><strong><%= reviews.length %></strong> avis recu(s)
            </p>
            <div class="messages-list">
                <% reviews.forEach(function(review) { %>
                    <div class="card message-row border-0 shadow-sm rounded-3 mb-1">
                        <div class="card-body py-2 px-2">
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <span class="avatar-circle avatar-sm"><%= review.author.charAt(0).toUpperCase() %></span>
                                <div class="message-main flex-grow-1 min-w-0">
                                    <div class="d-flex flex-wrap align-items-baseline gap-2">
                                        <span class="fw-bold small"><%= review.author %></span>
                                        <span class="avis-stars small">
                                            <%- include('../partials/stars', { rating: review.rating }) %>
                                        </span>
                                        <% if (review.status === 'approved') { %>
                                            <span class="badge bg-success">Publie</span>
                                        <% } else { %>
                                            <span class="badge bg-warning text-dark">En attente</span>
                                        <% } %>
                                        <small class="text-muted ms-auto text-nowrap">
                                            <i class="far fa-clock me-1"></i><%= new Date(review.created_at.replace(' ', 'T')).toLocaleString('fr-FR', { day: '2-digit', month: '2-digit', year: '2-digit', hour: '2-digit', minute: '2-digit' }) %>
                                        </small>
                                    </div>
                                    <p class="mb-0 message-text"><%= review.comment %></p>
                                </div>
                            </div>

                            <% if (user.role === 'admin') { %>
                                <div class="d-flex flex-wrap gap-2 mt-2 ps-5">
                                    <% if (review.status === 'pending') { %>
                                        <form action="/admin/avis/approve" method="POST">
                                            <input type="hidden" name="id" value="<%= review.id %>">
                                            <button type="submit" class="btn btn-sm btn-success rounded-pill px-3">
                                                <i class="fas fa-check me-1"></i>Publier
                                            </button>
                                        </form>
                                    <% } else { %>
                                        <form action="/admin/avis/unpublish" method="POST">
                                            <input type="hidden" name="id" value="<%= review.id %>">
                                            <button type="submit" class="btn btn-sm btn-outline-warning rounded-pill px-3">
                                                <i class="fas fa-eye-slash me-1"></i>Depublier
                                            </button>
                                        </form>
                                    <% } %>
                                    <form action="/admin/avis/delete" method="POST"
                                        onsubmit="return confirm('Supprimer cet avis ?')">
                                        <input type="hidden" name="id" value="<%= review.id %>">
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                            <i class="fas fa-trash me-1"></i>Supprimer
                                        </button>
                                    </form>
                                </div>
                            <% } else { %>
                                <p class="text-muted small mb-0 mt-2 ps-5">
                                    <i class="fas fa-eye me-1"></i>Seuls les administrateurs peuvent publier ou supprimer un
                                    avis.
                                </p>
                            <% } %>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="card border-0 shadow-sm rounded-3 admin-empty-wrap">
                <div class="card-body admin-empty d-flex align-items-center gap-2">
                    <i class="far fa-star empty-icon"></i>
                    <span class="admin-empty-text">
                        <strong>Aucun avis</strong>
                        <span class="text-muted">pour le moment</span>
                    </span>
                </div>
            </div>
        <% } %>

    </main>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
        crossorigin="anonymous"></script>
</body>

</html>
