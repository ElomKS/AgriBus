<!--When clicked on voir nos produits this page should display the list of products available for purchase-->
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Produits</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/styles/main.css">
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
</head>

<body>
    <%- include('../partials/header.ejs') %>

    <main class="content-wrapper">
      <div class="page-header">
    <h1>Produits disponibles pour achat</h1>
    <p class="text-muted">Trouvez vos produits favoris parmi les offres de la ferme.</p>
    <form action="/produits" method="GET" class="row g-2 justify-content-center mt-4">
        <div class="col-md-6">
            <input type="text" name="search" class="form-control" placeholder="Rechercher un produit..." value="<%= locals.searchQuery || '' %>">
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-success w-100">Chercher</button>
        </div>
    </form>
    <hr>
</div>

<!-- Products List -->
<div class="container products-container">
    <% if (locals.items && locals.items.length > 0) { %>
        <p class="text-center text-muted mb-4">Affichage de <%= locals.items.length %> produit(s)</p>
        <div class="row row-cols-1 row-cols-md-3 g-4 product-grid">
            <% locals.items.forEach(function(item) { %>
                <div class="col">
                    <div class="card">
                        <img src="<%= item.image %>" class="card-img-top" alt="<%= item.nom %>">
                        <div class="card-body">
                            <h5 class="card-title"><%= item.nom %></h5>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } else { %>
        <p>Aucun produit disponible pour le moment.</p>
    <% } %>
</div>
    </main>
<%- include('../partials/footer.ejs') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-1n4c4c4c4c4c4c4c4c4c4c4c4c4c4c4c4c4c4c4c4c4c4c4c4c4c4c4c4c4c4" crossorigin="anonymous">
</script>
</body>
</html>

