<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nos Produits - Kekeli Ferme</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/main.css">
    <link rel="stylesheet" href="/styles/produits.css">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>

<body>
    <%- include('../partials/header.ejs') %>

    <main class="content-wrapper">

        <!-- HERO -->
        <section class="produits-hero d-flex align-items-center">
            <div class="container py-5 text-white text-center">
                <span class="hero-kicker"><i class="fas fa-basket-shopping me-2"></i>Nos Produits</span>
                <h1 class="produits-title mt-3">Produits disponibles pour achat</h1>
                <p class="mb-4 opacity-75">Trouvez vos produits favoris parmi les offres de la ferme.</p>
                <form action="/produits" method="GET" class="row g-2 justify-content-center mt-4">
                    <div class="col-md-6 col-lg-5">
                        <div class="search-box">
                            <i class="fas fa-magnifying-glass"></i>
                            <input type="text" name="search" class="form-control"
                                placeholder="Rechercher un produit..."
                                value="<%= locals.searchQuery || '' %>">
                        </div>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-warning fw-semibold rounded-pill px-4 h-100">
                            Chercher
                        </button>
                    </div>
                </form>
            </div>
            <svg class="hero-wave" viewBox="0 0 1440 90" preserveAspectRatio="none">
                <path fill="#f0f2f5" d="M0,60 C360,110 1080,10 1440,60 L1440,90 L0,90 Z"></path>
            </svg>
        </section>

        <!-- PRODUITS -->
        <section class="container py-5">
            <% if (locals.items && locals.items.length > 0) { %>
                <p class="text-muted mb-4">
                    <i class="fas fa-boxes-stacked me-2 text-success"></i>Affichage de
                    <strong><%= locals.items.length %></strong> produit(s)
                    <% if (locals.searchQuery) { %>
                        pour « <%= locals.searchQuery %> »
                        <a href="/produits" class="ms-2 text-decoration-none">Réinitialiser</a>
                    <% } %>
                </p>

                <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
                    <% locals.items.forEach(function(item) { %>
                        <div class="col">
                            <div class="product-card">
                                <div class="product-img-wrap">
                                    <img src="<%= item.image %>" alt="<%= item.nom %>">
                                    <span class="product-price"><%= item.prix.toFixed(2) %> CFA</span>
                                </div>
                                <div class="product-body">
                                    <h3 class="product-name"><%= item.nom %></h3>
                                    <p class="product-desc"><%= item.description %></p>
                                    <div class="d-flex justify-content-between align-items-center mt-auto">
                                        <span class="product-stock">
                                            <i class="fas fa-check me-1"></i>En stock : <%= item.stock %>
                                        </span>
                                        <form action="/panier/add" method="POST">
                                            <input type="hidden" name="productId" value="<%= item.id %>">
                                            <input type="hidden" name="quantity" value="1">
                                            <button type="submit" class="btn btn-success btn-sm rounded-pill px-3">
                                                <i class="fas fa-cart-plus me-1"></i>Ajouter
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="empty-state text-center py-5">
                    <i class="fas fa-basket-shopping"></i>
                    <h2 class="mt-4">Aucun produit disponible pour le moment</h2>
                    <p class="text-muted">Essayez une autre recherche ou revenez bientôt, la ferme ne manque jamais
                        d'idées.</p>
                    <a href="/produits" class="btn btn-outline-success rounded-pill px-4 mt-2">
                        Voir tous les produits
                    </a>
                </div>
            <% } %>
        </section>

    </main>

    <%- include('../partials/footer.ejs') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
        crossorigin="anonymous"></script>
</body>

</html>
