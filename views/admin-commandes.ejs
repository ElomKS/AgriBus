<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Commandes - Administration - Kekeli Ferme</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/main.css">
    <link rel="stylesheet" href="/styles/admin.css">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>

<body class="admin-body">
    <main class="content-wrapper container py-3">

        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
            <div>
                <span class="section-kicker">Administration</span>
                <h1 class="fw-bold mb-0 fs-3">Commandes</h1>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge role-badge <%= user.role === 'admin' ? 'role-admin' : 'role-staff' %>">
                    <i class="fas <%= user.role === 'admin' ? 'fa-user-shield' : 'fa-user' %> me-1"></i><%= user.username %> · <%= user.role === 'admin' ? 'Admin' : 'Staff' %>
                </span>
                <a href="/admin" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                    <i class="fas fa-inbox me-1"></i>Messages
                </a>
                <a href="/admin/avis" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                    <i class="fas fa-star me-1"></i>Avis
                </a>
                <% if (user.role === 'admin') { %>
                    <a href="/admin/users" class="btn btn-sm btn-success rounded-pill px-3">
                        <i class="fas fa-users me-1"></i>Utilisateurs
                    </a>
                <% } %>
                <form action="/admin/logout" method="POST">
                    <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                        <i class="fas fa-right-from-bracket me-1"></i>Quitter
                    </button>
                </form>
            </div>
        </div>

        <% if (typeof orderSuccess !== 'undefined' && orderSuccess) { %>
            <div class="alert alert-success py-2"><%= orderSuccess %></div>
        <% } %>
        <% if (typeof orderError !== 'undefined' && orderError) { %>
            <div class="alert alert-danger py-2"><%= orderError %></div>
        <% } %>

        <% if (!orders || orders.length === 0) { %>
            <p class="admin-empty-line">
                <i class="fas fa-receipt"></i>Aucune commande pour le moment.
            </p>
        <% } %>

        <div class="d-flex flex-column gap-3">
            <% orders.forEach(function(order) { %>
                <div class="card border-0 shadow-sm rounded-4 order-row <%= order.status === 'nouvelle' ? 'order-row-new' : '' %>">
                    <div class="card-body py-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                            <div>
                                <strong class="order-ref"><%= order.reference %></strong>
                                <span class="badge order-status order-status-<%= order.status %>">
                                    <%= order.status === 'nouvelle' ? 'Nouvelle' : order.status === 'traitee' ? 'Traitée' : order.status === 'livree' ? 'Livrée' : 'Annulée' %>
                                </span>
                                <div class="small text-muted">
                                    <%= new Date(String(order.created_at).replace(' ', 'T')).toLocaleString('fr-FR', { dateStyle: 'short', timeStyle: 'short' }) %>
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="fs-5 fw-bold"><%= order.total.toLocaleString('fr-FR') %> FCFA</div>
                                <div class="small text-muted"><%= order.items.length %> article(s)</div>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="small">
                                    <div><strong><%= order.nom %></strong></div>
                                    <div class="text-muted">
                                        <a href="mailto:<%= order.email %>"><%= order.email %></a><br>
                                        <%= order.telephone %><br>
                                        <%= order.adresse %>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <table class="table table-sm mb-0 order-items">
                                    <tbody>
                                        <% order.items.forEach(function(item) { %>
                                            <tr>
                                                <td><%= item.nom %></td>
                                                <td class="text-center text-muted">×<%= item.quantity %></td>
                                                <td class="text-end"><%= (item.prix * item.quantity).toLocaleString('fr-FR') %></td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <% if (order.instructions) { %>
                            <div class="small text-muted mt-2">
                                <i class="fas fa-note-sticky me-1"></i><%= order.instructions %>
                            </div>
                        <% } %>

                        <% if (user.role === 'admin') { %>
                            <form action="/admin/commandes/statut" method="POST" class="d-flex flex-wrap align-items-center gap-2 mt-3">
                                <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
                                <input type="hidden" name="id" value="<%= order.id %>">
                                <label class="visually-hidden" for="status-<%= order.id %>">Statut de la commande</label>
                                <select class="form-select form-select-sm w-auto" id="status-<%= order.id %>" name="status">
                                    <% statuses.forEach(function(s) { %>
                                        <option value="<%= s %>" <%= s === order.status ? 'selected' : '' %>>
                                            <%= s === 'nouvelle' ? 'Nouvelle' : s === 'traitee' ? 'Traitée' : s === 'livree' ? 'Livrée' : 'Annulée' %>
                                        </option>
                                    <% }); %>
                                </select>
                                <button type="submit" class="btn btn-sm btn-success rounded-pill px-3">
                                    <i class="fas fa-check me-1"></i>Enregistrer
                                </button>
                            </form>
                        <% } %>
                    </div>
                </div>
            <% }); %>
        </div>

    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
        crossorigin="anonymous"></script>
</body>

</html>