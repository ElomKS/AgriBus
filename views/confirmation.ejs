<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Confirmation de commande - Ferme Bio</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/styles/main.css">
</head>
<body>
    <%- include('../partials/header.ejs') %>

    <main class="container my-5">
        <div class="card border-success">
            <div class="card-header bg-success text-white">
                <h3 class="card-title mb-0">
                    <i class="fas fa-check-circle me-2"></i>Commande Confirmée
                </h3>
            </div>
            <div class="card-body">
                <h5 class="card-title">Merci pour votre commande !</h5>
                <p class="card-text">Votre numéro de commande est : <strong>#<%= orderId %></strong></p>

                <div class="alert alert-info">
                    <h6><i class="fas fa-info-circle me-2"></i>Détails de livraison</h6>
                    <p class="mb-0">Votre commande sera livrée dans les 24-48h.</p>
                </div>

                <div class="mt-4">
                    <h6>Résumé de la commande :</h6>
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Produit</th>
                                <th>Quantité</th>
                                <th>Prix</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% order.items.forEach(function(item) { %>
                            <tr>
                                <td><%= item.nom %></td>
                                <td><%= item.quantity %></td>
                                <td><%= (item.prix * item.quantity).toFixed(2) %> $</td>
                            </tr>
                            <% }); %>
                        </tbody>
                        <tfoot>
                            <tr class="table-success">
                                <td colspan="2"><strong>Total</strong></td>
                                <td><strong><%= order.total.toFixed(2) %> $</strong></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="mt-4">
                    <a href="/produits" class="btn btn-primary">
                        <i class="fas fa-shopping-basket me-2"></i>Continuer vos achats
                    </a>
                    <a href="#" class="btn btn-outline-secondary ms-2" onclick="window.print()">
                        <i class="fas fa-print me-2"></i>Imprimer la confirmation
                    </a>
                </div>
            </div>
        </div>
    </main>

    <%- include('../partials/footer.ejs') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>